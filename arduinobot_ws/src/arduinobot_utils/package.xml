<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arduinobot_utils</name>
  <version>0.0.0</version>
  <description>Helper utilities for the Arduinobot robot arm project, including services for converting between Euler angles and quaternions in C++ and Python.</description>
  <maintainer email="andresaleman142@gmail.com">control</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>ament_xmake_python</build_depend>

  <depend>rclpy</depend>
  <depend>rclcpp</depend>
  <depend>tf2</depend>
  <depend>arduinobot_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
